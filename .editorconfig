root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yaml,yml}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2
quote_type = single

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.tf]
indent_size = 2

[*.sql]
indent_size = 2
