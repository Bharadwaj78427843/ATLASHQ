{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlashq.ai/schemas/tools.schema.json",
  "title": "AtlasHQ Skill Tools",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools", "permissions"],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_edit_code", "can_run_tests", "can_release", "can_modify_policies"],
      "properties": {
        "can_edit_code": { "type": "boolean" },
        "can_run_tests": { "type": "boolean" },
        "can_release": { "type": "boolean" },
        "can_modify_policies": { "type": "boolean" }
      }
    }
  }
}
