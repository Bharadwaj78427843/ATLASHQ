{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlashq.ai/schemas/workflow.schema.json",
  "title": "AtlasHQ Skill Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "parallelizable": {
            "type": "boolean"
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
