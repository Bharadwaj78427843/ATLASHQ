{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlashq.ai/schemas/skill.schema.json",
  "title": "AtlasHQ Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "version",
    "description",
    "system_prompt",
    "tools",
    "workflow",
    "policies",
    "outputs"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "AtlasHQSkill"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "system_prompt": {
      "type": "string",
      "minLength": 20
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "workflow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflowStep"
      },
      "minItems": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policyRule"
      },
      "minItems": 1
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ioContract"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ioContract"
      },
      "minItems": 1
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/handoff"
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    }
  },
  "$defs": {
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "parallelizable": {
          "type": "boolean",
          "default": false
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "severity"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warn", "block"]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_edit_code": { "type": "boolean", "default": true },
        "can_run_tests": { "type": "boolean", "default": true },
        "can_release": { "type": "boolean", "default": false },
        "can_modify_policies": { "type": "boolean", "default": false }
      }
    },
    "ioContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "schema": {
          "type": "string",
          "minLength": 2
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to_skill", "when", "payload"],
      "properties": {
        "to_skill": {
          "type": "string",
          "minLength": 2
        },
        "when": {
          "type": "string",
          "minLength": 3
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
