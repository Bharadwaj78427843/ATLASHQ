{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlashq.ai/schemas/skill-package.schema.json",
  "title": "AtlasHQ Skill Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "display_name",
    "version",
    "description",
    "artifacts",
    "interfaces",
    "tests"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "AtlasHQSkillPackage"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "owners": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "workflow", "policies", "tools"],
      "properties": {
        "prompt": { "type": "string", "pattern": "^.+\\.md$" },
        "workflow": { "type": "string", "pattern": "^.+\\.ya?ml$" },
        "policies": { "type": "string", "pattern": "^.+\\.ya?ml$" },
        "tools": { "type": "string", "pattern": "^.+\\.ya?ml$" }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "requires", "produces"],
      "properties": {
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "requires": { "$ref": "#/$defs/stringList" },
        "produces": { "$ref": "#/$defs/stringList" }
      }
    },
    "knowledge": { "$ref": "#/$defs/stringList" },
    "handoffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/handoff" }
    },
    "tests": {
      "type": "array",
      "items": { "type": "string", "pattern": "^tests/.+\\.ya?ml$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "success_criteria": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to_skill", "when", "payload"],
      "properties": {
        "to_skill": { "type": "string", "minLength": 2 },
        "when": { "type": "string", "minLength": 3 },
        "payload": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
