# Atlas .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/
.cache/

# Environment variables — NEVER commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# Secrets and credentials — NEVER commit
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/

# TypeScript
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt

# Infrastructure — local state
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Docker
.dockerignore

# Package manager locks — commit these
# (do NOT add package-lock.json or yarn.lock here)

# OS
.DS_Store
.AppleDouble
.LSOverride
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Atlas-specific
.atlas-local/
brain-cache/
